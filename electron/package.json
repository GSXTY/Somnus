{
  "name": "respiratory-viewer-desktop",
  "productName": "Somnus",
  "version": "0.3.0-beta.9",
  "description": "Somnus",
  "author": "VVFLY",
  "private": true,
  "main": "main.cjs",
  "packageManager": "pnpm@11.25.0",
  "devDependencies": {
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.vvfly.respiratoryviewer",
    "electronVersion": "45.3.2",
    "npmRebuild": false,
    "asarUnpack": [
      "node_modules/node-pty/**"
    ],
    "files": [
      "*.cjs",
      "*.mjs",
      "runtime/**/*.cjs",
      "runtime/**/*.mjs",
      "runtime/*.json",
      "package.json",
      "brand/*",
      "!*.test.cjs",
      "!acp-dot-relay-client.cjs",
      "!runtime/**/*.test.cjs",
      "!runtime/**/*.test.mjs"
    ],
    "directories": {
      "output": "../dist/electron"
    },
    "extraResources": [
      {
        "from": "../build/electron/backend/SomnusBackend",
        "to": "backend"
      },
      {
        "from": "../desktop/dsh_next/oar",
        "to": "somnus/dsh-oar"
      },
      {
        "from": "../build/electron/THIRD_PARTY_LICENSES",
        "to": "THIRD_PARTY_LICENSES"
      },
      {
        "from": "../USER_GUIDE.md",
        "to": "使用说明.txt"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "brand/somnus.ico",
      "executableName": "Somnus",
      "signExecutable": false,
      "publish": {
        "provider": "github",
        "owner": "GSXTY",
        "repo": "Somnus-Releases",
        "private": false,
        "channel": "latest"
      },
      "artifactName": "Somnus-Setup-${version}-windows-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "shortcutName": "Somnus"
    },
    "mac": {
      "target": "zip",
      "icon": "brand/somnus.icns",
      "executableName": "Somnus",
      "identity": "-",
      "hardenedRuntime": false,
      "extendInfo": {
        "CFBundleDisplayName": "Somnus"
      },
      "artifactName": "Somnus-${version}-electron-macos-${arch}.${ext}"
    },
    "extends": "./electron-builder.config.cjs"
  },
  "dependencies": {
    "electron-updater": "6.8.3",
    "node-pty": "1.2.0-beta.15"
  }
}
