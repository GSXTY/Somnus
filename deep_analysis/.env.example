# Independent trial credentials. This does NOT change AI_ASSISTANT_* chat settings.
# Copy these entries into your server's environment or its existing .env yourself.
# Use the compatible API base and model name provided by your model service.
DEEP_ANALYSIS_BASE_URL=https://api.example.test/v1
DEEP_ANALYSIS_MODEL=your-model
DEEP_ANALYSIS_API_KEY=
# An existing local image is required. The application never builds or pulls it.
DEEP_ANALYSIS_DOCKER_IMAGE=ya70-deep-analysis:trial
DEEP_ANALYSIS_MAX_FILE_MB=5
DEEP_ANALYSIS_MAX_ROWS=100000
DEEP_ANALYSIS_MAX_COLUMNS=200
DEEP_ANALYSIS_MAX_ROUNDS=4
DEEP_ANALYSIS_TASK_TIMEOUT=240
DEEP_ANALYSIS_CODE_TIMEOUT=60
DEEP_ANALYSIS_MODEL_TIMEOUT=60
