{
  "files.exclude": {
    "**/.git": true,
    "**/dist": true,
    "**/build": true,
    "**/.tmp": true,
    "**/.local-backups": true,
    "**/.build-deps": true,
    "**/.mcp-deps": true,
    "**/.frontend-cache": true,
    "**/.release-tools": true,
    "**/vendor": true,
    "**/node_modules": true,
    "**/.venv": true,
    "**/venv": true,
    "**/__pycache__": true,
    "**/.pytest_cache": true,
    "**/.mypy_cache": true,
    "**/.ruff_cache": true,
    "**/.cache": true,
    "**/release": true,
    "**/.env": true,
    "**/.env.*": true
  },
  "search.exclude": {
    "**/.git": true,
    "**/dist": true,
    "**/build": true,
    "**/.tmp": true,
    "**/.local-backups": true,
    "**/.build-deps": true,
    "**/.mcp-deps": true,
    "**/.frontend-cache": true,
    "**/.release-tools": true,
    "**/vendor": true,
    "**/node_modules": true,
    "**/.venv": true,
    "**/venv": true,
    "**/__pycache__": true,
    "**/.pytest_cache": true,
    "**/.mypy_cache": true,
    "**/.ruff_cache": true,
    "**/.cache": true,
    "**/release": true,
    "**/.env": true,
    "**/.env.*": true
  },
  "files.watcherExclude": {
    "**/.git/**": true,
    "**/dist/**": true,
    "**/build/**": true,
    "**/.tmp/**": true,
    "**/.local-backups/**": true,
    "**/.build-deps/**": true,
    "**/.mcp-deps/**": true,
    "**/.frontend-cache/**": true,
    "**/.release-tools/**": true,
    "**/vendor/**": true,
    "**/node_modules/**": true,
    "**/.venv/**": true,
    "**/venv/**": true,
    "**/__pycache__/**": true,
    "**/.pytest_cache/**": true,
    "**/.mypy_cache/**": true,
    "**/.ruff_cache/**": true,
    "**/.cache/**": true,
    "**/release/**": true
  },
  "git.autoRepositoryDetection": false,
  "git.openRepositoryInParentFolders": "never",
  "git.autorefresh": false,
  "git.autofetch": false,
  "git.decorations.enabled": false,
  "search.followSymlinks": false
}
