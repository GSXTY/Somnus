{
  "name": "@local/somnus-tool-deep-analysis",
  "version": "0.1.0",
  "private": true,
  "description": "Somnus 业务工具插件：深度分析。页面由插件提供，入口在内置「工具」页。",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./dist/client.js",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "dist/client.js",
    "cordis.patch.yml",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web", "immediately": true },
    "somnus": { "kind": "tool" }
  }
}